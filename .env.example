# ============================================================
# JBI Detection & Segmentation API — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults; .env is optional for dev.
# ============================================================

# --- Environment ---
ENVIRONMENT=development
# Options: "development", "production"
# development: auto-reload, access logs enabled
# production:  no reload, structured JSON logging only

# --- Model & Pipeline ---
MODEL_PATH=model_weights/best.pt
PROCESSING_MODE=auto
BATCH_SIZE=8
MIN_SEGMENT_DURATION=5
CRF_VALUE=16
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
FFMPEG_PRESET=veryslow
FFMPEG_THREADS=4

# --- Storage ---
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs

# --- Upload & Validation ---
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_EXTENSIONS=.mp4,.avi,.mkv,.mov

# --- Job Management ---
JOB_TTL_HOURS=24
MAX_CONCURRENT_JOBS=3

# --- Logging ---
LOG_LEVEL=INFO

# --- Server ---
# CORS Configuration
# USE_CORS: Enable (1) or disable (0) CORS middleware
#   1 = CORS enabled with origin checking (default, recommended for production)
#   0 = CORS disabled, all origins allowed (use for internal networks or debugging)
USE_CORS=1

# CORS_ORIGINS: Allowed origins when USE_CORS=1
# Comma-separated list, no spaces. Include protocol and port.
# Examples:
#   Development: http://localhost:3000,http://localhost:3001
#   Production:  https://app.anotasi.ai,https://admin.anotasi.ai
#   Wildcard:    * (not recommended with credentials)
CORS_ORIGINS=*

API_V1_PREFIX=/api/v1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# --- Kafka Configuration ---
# Comma-separated list of Kafka brokers
# For Docker: kafka:9092
# For local dev: localhost:9092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=pipeline
KAFKA_MAX_POLL_RECORDS=1
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_HEARTBEAT_INTERVAL_MS=15000
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_BASE_DELAY_SECONDS=5

# --- MinIO / S3 Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=anotasi-videos
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY=3600
