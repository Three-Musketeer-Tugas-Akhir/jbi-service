# ============================================================
# JBI Detection & Segmentation API — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults; .env is optional for dev.
# ============================================================

# --- Environment ---
ENVIRONMENT=development
# Options: "development", "production"
# development: auto-reload, access logs enabled
# production:  no reload, structured JSON logging only

# --- Model & Pipeline ---
MODEL_PATH=model_weights/best.pt
PROCESSING_MODE=auto
BATCH_SIZE=8
MIN_SEGMENT_DURATION=5
CRF_VALUE=16
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
FFMPEG_PRESET=veryslow
FFMPEG_THREADS=4

# --- Storage ---
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs

# --- Upload & Validation ---
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_EXTENSIONS=.mp4,.avi,.mkv,.mov

# --- Job Management ---
JOB_TTL_HOURS=24
MAX_CONCURRENT_JOBS=3

# --- Logging ---
LOG_LEVEL=INFO

# --- Server ---
CORS_ORIGINS=*
API_V1_PREFIX=/api/v1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# --- MinIO / S3 Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=anotasi-videos
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY=3600
