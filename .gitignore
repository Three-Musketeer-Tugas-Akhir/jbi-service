# ============================================================
# JBI Detection & Segmentation — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/

# --- Environment & Secrets ---
.env

# --- Storage (uploaded & processed videos) ---
storage/uploads/*
storage/outputs/*
!storage/uploads/.gitkeep
!storage/outputs/.gitkeep

# --- Model Weights (large binaries) ---
model_weights/*.onnx
!model_weights/.gitkeep

# --- Notebook Artifacts ---
.ipynb_checkpoints/
output.txt
output2.txt
object_detection_times*.txt

# --- Docker ---
docker-compose.override.yml

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

logs/